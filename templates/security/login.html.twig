{#
    Template: security/login.html.twig
    Extends: base_html.twig

    Template pour formulaire de connection d'utilisateur

    Role:
        Afficher le formulaire de connection d'utilisateur

    Parameters:
        error - Les messages d'erreur
        app.user - L'utilisateur connectée
        last_username - Le dernier nom d'utilisateur (email) introduit dans le formulaire

#}
{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Connectez-vous à votre compte!{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                Vous êtes maintenant connectez comme {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Déconnecter</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connectez-vous à votre compte</h1>
        <label for="username">Email</label>
        <input type="email" value="{{ last_username }}" name="email" id="email" class="form-control" autocomplete="email" required autofocus>
        <label for="password">Mot de passe</label>
        <input type="password" name="password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button class="btn-outline" type="submit">
            Connecter
        </button>
    </form>
{% endblock %}

{#
    Fragment: user/_delete_form.html.twig

    Fragment pour le formulaire pour effacer un utilisateur

    Parameters:
        user.id - L'id de l'utilisateur

#}
<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Vous êtes sur de bien vouloir effacer cette utilisateur?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn">Effacer</button>
</form>

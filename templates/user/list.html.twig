{#
    Template: user/list.html.twig
    Extends: base_html.twig

    Template pour la page de la liste d'utilisateurs

    Role:
        Afficher la page avec la liste d'utilisateurs

    Parameters:
        users - La liste des utilisateurs

#}

{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Liste d'utilisateurs{% endblock %}

{% block body %}
    <h1>Liste d'utilisateurs</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Pseudo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            {% set banMessage = user.banni ? "débannir" : "bannir" %}

            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.pseudo }}</td>
                <td>
                    <form class="hidden" method="post" id="delete-form-{{ user.id }}" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Vous êtes sur de bien vouloir effacer cette utilisateur?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    </form>
                    <form class="hidden" method="post" id="ban-form-{{ user.id }}" action="{{ path('app_user_ban', {'id': user.id}) }}" onsubmit="return confirm('Vous êtes sur de bien vouloir {{ banMessage }} cette utilisateur?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ user.id) }}">
                    </form>
                    <a class="btn-outline-blue" href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier l'utilisateur</a>
                    <a class="btn-outline-red" href="#" onclick="event.preventDefault(); document.getElementById('delete-form-{{ user.id }}').requestSubmit();">Supprimer l'utilisateur</a>
                    <a class="btn-outline-orange" href="#" onclick="event.preventDefault(); document.getElementById('ban-form-{{ user.id }}').requestSubmit();">
                    {% if user.banni %}
                        Débannir l'utilisateur
                    {% else %}
                        Bannir l'utilisateur
                    {% endif %}
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun utilisateur trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}

{#
    Fragment: article/section/_search.html.twig
    Extends: base_html.twig

    Fragment pour la section de recherche des articles
    
    Parameters:
        search - search request ($_GET['search'])

#}
<form method="get" class="search-bar">
    <div class="flex flex-row flex-nowrap">
        <input type="text" name="search" value="{{ app.request.query.get('search') }}" placeholder="Rechercher" class="search-bar__input">
        <input class="hidden" type="text" name="category" value="{{ app.request.query.get('category') }}">
        
        <button type="submit" class="text-gray-600">
            <svg class="w-4 h-4"><use xlink:href="#search"></use></svg>
        </button>
    </div>
</form>
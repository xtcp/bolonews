{#
    Fragment: app/section/_last_articles.html.twig
    Extends: base_html.twig

    Fragment de section pour les derniers articles

    Parameters:
        featuredArticle - Article mis en avant

#}
<h2 class="section__titre">Dernieres parutions</h2>
<div class="grid grid-cols-2 gap-6">
    {% for article in latestArticles %}
        {{ include('article/component/_card.html.twig', {article: article}) }}
    {% else %}
        <p class="text-gray-500 col-span-2">Les derniers articles publiés appareteront ici</p>
    {% endfor %}
</div>